];
 
/* ---------- helpers ---------- */
const $=id=>document.getElementById(id);
const LS={get(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
const TOTAL=70, MINS=25;
let mode='L', user=null, Q=null, timerId=null, wrongOnly=false, lastResult=null;
 
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function show(id){['auth','home','quiz','result'].forEach(x=>$(x).classList.toggle('hide',x!==id))}
 
/* ---------- login ---------- */
function submitAuth(e){
  e.preventDefault();
  const nm=$('nm').value.trim().replace(/\s+/g,' '),err=$('err');err.textContent='';
  const digits=$('reg').value.replace(/\D/g,'');
  if(nm.length<3){err.textContent='Enter your full name.';return false}
  if(digits.length<9||digits.length>11){err.textContent='Enter a valid registration number, e.g. 2021242345 (no slash needed).';return false}
  const reg=digits.slice(0,4)+'/'+digits.slice(4);
  const u={reg:reg,name:nm};LS.set('gs208_session',u);enter(u);
  return false;
}
function enter(u){
  user={reg:u.reg,name:u.name};
  $('who').classList.remove('hide');$('whoTxt').textContent=user.reg;
  const act=LS.get('gs208_active_'+user.reg,null);
  if(act&&act.end>Date.now()){Q=act;showQuiz()}
  else{if(act)LS.set('gs208_active_'+user.reg,null);showHome()}
}
function logout(){
  if(timerId){clearInterval(timerId);timerId=null}
  LS.set('gs208_session',null);user=null;Q=null;
  $('who').classList.add('hide');$('nm').value='';$('reg').value='';show('auth');
}
 
/* ---------- home ---------- */
function showHome(){
  $('hName').textContent=user.name;$('hReg').textContent=user.reg;
  const h=LS.get('gs208_hist_'+user.reg,[]);
  $('hist').innerHTML=h.length?'<table><tr><th>Date</th><th>Score</th><th>%</th></tr>'+h.slice().reverse().slice(0,10).map(r=>'<tr><td>'+r.d+'</td><td>'+r.s+'/'+r.t+'</td><td>'+r.p+'%</td></tr>').join('')+'</table>':'No attempts yet.';
  show('home');
}
 
/* ---------- quiz ---------- */
function startQuiz(){
  const pick=shuffle(B).slice(0,Math.min(TOTAL,B.length)).map(r=>{
    const opts=shuffle([0,1,2,3]);
    return {q:r[0],o:opts.map(i=>r[i+1]),a:opts.indexOf(0)};
  });
  Q={qs:pick,ans:pick.map(()=>-1),i:0,end:Date.now()+MINS*60000,start:Date.now()};
  saveQ();showQuiz();
}
function saveQ(){if(user&&Q)LS.set('gs208_active_'+user.reg,Q)}
function showQuiz(){
  show('quiz');render();tick();
  if(timerId)clearInterval(timerId);timerId=setInterval(tick,1000);
  window.scrollTo(0,0);
}
function tick(){
  if(!Q)return;
  const left=Math.max(0,Q.end-Date.now()),m=Math.floor(left/60000),s=Math.floor(left/1000)%60;
  const t=$('timer');t.textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
  t.classList.toggle('low',left<=5*60000);
  if(left<=0)finish(true);
}
function render(){
  const q=Q.qs[Q.i],n=Q.qs.length;
  $('prog').textContent='Question '+(Q.i+1)+' of '+n;
  const done=Q.ans.filter(x=>x>=0).length;$('ansCount').textContent='Answered: '+done+'/'+n;
  $('qn').textContent='Question '+(Q.i+1);$('qt').textContent=q.q;
  $('opts').innerHTML=q.o.map((t,k)=>'<button class="opt'+(Q.ans[Q.i]===k?' sel':'')+'" onclick="pickOpt('+k+')"><b>'+'ABCD'[k]+'.</b><span></span></button>').join('');
  Array.from($('opts').children).forEach((b,k)=>b.querySelector('span').textContent=q.o[k]);
  $('prev').disabled=Q.i===0;$('next').textContent=Q.i===n-1?'Review':'Next';
  $('pal').innerHTML=Q.qs.map((_,k)=>'<button class="'+(Q.ans[k]>=0?'ans ':'')+(k===Q.i?'cur':'')+'" onclick="jump('+k+')">'+(k+1)+'</button>').join('');
}
function pickOpt(k){Q.ans[Q.i]=k;saveQ();render()}
function go(d){const n=Q.qs.length;Q.i=Math.min(n-1,Math.max(0,Q.i+d));saveQ();render();window.scrollTo(0,0)}
function jump(k){Q.i=k;saveQ();render();window.scrollTo(0,0)}
function confirmSubmit(){
  const un=Q.ans.filter(x=>x<0).length;
  if(confirm(un?('You have '+un+' unanswered question(s). Submit anyway?'):'Submit your test now?'))finish(false);
}
function finish(auto){
  if(!Q)return;
  if(timerId){clearInterval(timerId);timerId=null}
  const t=Q.qs.length;let s=0;Q.qs.forEach((q,i)=>{if(Q.ans[i]===q.a)s++});
  const p=Math.round(s/t*100);
  lastResult={qs:Q.qs,ans:Q.ans,s:s,t:t,p:p,auto:auto};
  const h=LS.get('gs208_hist_'+user.reg,[]);
  h.push({d:new Date().toLocaleString(),s:s,t:t,p:p});LS.set('gs208_hist_'+user.reg,h);
  LS.set('gs208_active_'+user.reg,null);Q=null;
  showResult();
}
function showResult(){
  const r=lastResult;wrongOnly=false;$('tgl').textContent='Show wrong only';
  $('sc').textContent=r.s+' / '+r.t;$('pc').textContent=r.p+'%';
  $('rm').textContent=(r.auto?'Time up - test auto-submitted. ':'')+(r.p>=70?'Excellent work!':r.p>=50?'Good, keep practising.':r.p>=40?'Fair - read your notes again.':'Needs more reading - review the answers below.');
  renderReview();show('result');window.scrollTo(0,0);
}
function renderReview(){
  const r=lastResult,box=$('rvList');box.innerHTML='';
  r.qs.forEach((q,i)=>{
    const ok=r.ans[i]===q.a;if(wrongOnly&&ok)return;
    const d=document.createElement('div');d.className='rv '+(ok?'ok':'bad');
    const h=document.createElement('div');h.style.fontWeight='600';h.textContent=(i+1)+'. '+q.q;
    const a=document.createElement('div');a.className='a';
    a.innerHTML='<span class="'+(ok?'good':'wrong')+'">Your answer:</span> <span></span>';
    a.lastChild.textContent=r.ans[i]>=0?q.o[r.ans[i]]:'(not answered)';
    d.appendChild(h);d.appendChild(a);
    if(!ok){const c=document.createElement('div');c.className='a';c.innerHTML='<span class="good">Correct answer:</span> <span></span>';c.lastChild.textContent=q.o[q.a];d.appendChild(c)}
    box.appendChild(d);
  });
  if(!box.children.length)box.innerHTML='<div class="card" style="text-align:center">Perfect score - nothing wrong to show!</div>';
}
function toggleWrong(){wrongOnly=!wrongOnly;$('tgl').textContent=wrongOnly?'Show all':'Show wrong only';renderReview()}
 
/* ---------- init ---------- */
window.addEventListener('beforeunload',saveQ);
$('reg').addEventListener('input',function(){const d=this.value.replace(/\D/g,'').slice(0,11);this.value=d.length>4?d.slice(0,4)+'/'+d.slice(4):d});
(function(){
  const s=LS.get('gs208_session',null);
  if(s&&s.reg&&s.name)enter(s);else show('auth');
})();
</script>
