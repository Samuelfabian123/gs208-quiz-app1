</section>
 
<section id="quiz" class="hide">
  <div id="bar">
    <div><div class="qn" id="prog"></div><div class="hint" id="ansCount"></div></div>
    <div id="timer">25:00</div>
    <button class="btn red sm" onclick="confirmSubmit()">Submit</button>
  </div>
  <div class="card">
    <div class="qn" id="qn"></div>
    <div class="qt" id="qt"></div>
    <div id="opts"></div>
    <div class="row" style="margin-top:12px">
      <button class="btn alt" id="prev" onclick="go(-1)">Previous</button>
      <span class="sp"></span>
      <button class="btn" id="next" onclick="go(1)">Next</button>
    </div>
  </div>
  <div class="card"><div class="qn">Question navigator</div><div id="pal"></div></div>
</section>
 
<section id="result" class="hide">
  <div class="card" style="text-align:center">
    <div class="hint">Your score</div>
    <div class="score" id="sc"></div>
    <div id="pc" style="font-weight:700"></div>
    <div id="rm" class="hint" style="margin:6px 0 14px"></div>
    <div class="row" style="justify-content:center">
      <button class="btn" onclick="startQuiz(true)">Retake (new questions)</button>
      <button class="btn alt" onclick="showHome()">Home</button>
      <button class="btn alt" id="tgl" onclick="toggleWrong()">Show wrong only</button>
    </div>
  </div>
  <div id="rvList"></div>
</section>
 
</main>
 
